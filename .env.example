# ローカルで .env にコピーし、対象環境を設定してください。
BASE_URL=http://localhost:3000
# 手動の AI デモで 4173 番が使用中の場合のみ指定。独立 demo:check は空きポートを選びます。
# DEMO_PORT=4183
# agents:run の代替 CLI 経路で使う provider。対話の native 委譲には適用しません。
# AGENT_PROVIDER=claude
# 認証済み状態が必要な場合のみ、ローカルで用意したファイルを指定します。
# STORAGE_STATE=playwright/.auth/user.json
